# Default provider for local neuroreview.
# OpenRouter free models still require an OpenRouter API key.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_MODEL=openai/gpt-oss-20b:free
PUBLIC_N8N_URL=https://example.com/
WEBHOOK_TOKEN=replace-with-random-token

# Optional fallback provider.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.4-nano

# Optional: used for private GitHub PR diffs and posting PR comments from GitHub pull_request webhooks.
GIT_TOKEN=
